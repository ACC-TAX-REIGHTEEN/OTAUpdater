$stage = Join-Path $env:TEMP "ota_build_stage"; Remove-Item $stage -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Path "$stage\Dapur" | Out-Null; Copy-Item "MainOrchestrator.py" -Destination $stage; Copy-Item "Dapur\*" -Destination "$stage\Dapur" -Recurse -Exclude "main.zip","ota.log","*.bak","__pycache__"; Compress-Archive -Path "$stage\*" -DestinationPath "Dapur\OTA\main.zip" -Force; (Get-FileHash "Dapur\OTA\main.zip" -Algorithm SHA256).Hash.ToLower() | Out-File "Dapur\OTA\main.sha256" -Encoding ascii -NoNewline; Remove-Item $stage -Recurse -Force
